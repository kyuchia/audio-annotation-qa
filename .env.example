# Where the dataset lives on the host. docker compose mounts it read-only at /data
# inside the container, so a corpus root is a path underneath /data — the demo subset
# below is imported with --root /data/vocadito.
#
# Point this at a full vocadito release to use all 40 excerpts instead.
DATASET_ROOT=./demo-data

# Where the original recordings live on the host, one subdirectory per item. Only needed
# for a corpus whose annotations were made against audio that is not shipped beside them;
# the vocadito demo corpus ships its own audio and does not use this. docker compose
# mounts it read-only at /recordings.
RECORDING_ROOT=./recordings

# Debug defaults to off. Set it to 1 for local development only: with it on, any error
# response carries a traceback, your settings and local variables.
DJANGO_DEBUG=1

# Which Host headers this installation answers to. The default allows local access only;
# a deployment reachable under any other name must list its own hostnames here.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# How timestamps are displayed. They are stored in UTC regardless, so this is a display
# choice; set it to a local zone only if you want the admin and logs rendered that way.
TZ=UTC

# Change this for any installation that is not a throwaway local one.
DJANGO_SECRET_KEY=dev-only-not-for-production

# The rest of the settings below are shown at their defaults. Uncomment a line to change
# one; docker compose passes every variable here into the django container.

# Origins allowed to call the API with credentials, also used as the CSRF trusted
# origins. The Vite dev server is what the default lists.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Root logger level: DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO

# Database connection. POSTGRES_HOST is the compose service name and POSTGRES_PORT the
# port inside that container, which is the plain 5432 whatever the host publishes.
#
# The db container reads the name, user and password once, when it creates its data
# directory. Changing them for a stack that has already started leaves the old database
# in place with the old credentials and Django unable to connect; a changed set needs a
# new volume.
# POSTGRES_DB=annotations
# POSTGRES_USER=annotations
# POSTGRES_PASSWORD=annotations
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
